# Supabase (browser-safe values only).
# Copy this file to .env.local and fill in the values from your Supabase project
# dashboard: Project Settings -> API.
#
# IMPORTANT: never add a service-role key or any other secret here. Only the
# public anon key is allowed in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
